local function scanGodMode()
	if not godModeEnabled then
		return
	end

	applyGodModeSelf()

	for _, info in ipairs(GOD_MAPS) do
		local map = workspace:FindFirstChild(info.name)
		if map then
			for _, obj in ipairs(map:GetDescendants()) do
				if obj:IsA("Model") and (obj:FindFirstChild("Enemy") or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild(info.head, true)) then
					bindNeuter(obj)
				end
			end
		end
	end

	local mall = workspace:FindFirstChild("Mall")
	if mall then
		for _, obj in ipairs(mall:GetDescendants()) do
			if obj:IsA("Model") then
				local hasHead = obj:FindFirstChild("MousyHead", true)
				local hasPoints = obj:FindFirstChild("MousyPoints", true)
				if hasHead and hasPoints then
					bindNeuter(obj)
				end
			end
		end
		local loaded = workspace:FindFirstChild("LoadedMap")
		if loaded and loaded:FindFirstChild("Part1") then
			local jail = loaded.Part1:FindFirstChild("JailbreakEvent")
			if jail then
				handleLasers(jail)
			end
		end
	end

	local plant = workspace:FindFirstChild("Plant")
	if plant then
		for _, obj in ipairs(plant:GetDescendants()) do
			handleMrP(obj)
		end
	end

	local piggyFolder = workspace:FindFirstChild("PiggyNPC")
	if piggyFolder then
		for _, bot in ipairs(piggyFolder:GetChildren()) do
			if bot:IsA("Model") then
				bindNeuter(bot)
			end
		end
	end

	local outpost = workspace:FindFirstChild("Outpost")
	if outpost then
		for _, folder in ipairs(outpost:GetChildren()) do
			if folder:IsA("Folder") or folder:IsA("Model") then
				for _, model in ipairs(folder:GetChildren()) do
					if model:IsA("Model") then
						bindNeuter(model)
					end
				end
			elseif folder:IsA("Model") then
				bindNeuter(folder)
			end
		end
	end
end

local function isAlly(model)
	if not model or not model:IsA("Model") then
		return false
	end
	for headName in pairs(ALLY_HEADS) do
		if model:FindFirstChild(headName, true) then
			return true
		end
	end
	return false
end

local function bindAlly(model)
	if not model or alliesTracked[model] then
		return
	end
	alliesTracked[model] = true
	neuterModel(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Attacking, false)
		end)
	end
	model.DescendantAdded:Connect(function(obj)
		if alliesNoDamageEnabled then
			destroyTouch(obj)
		end
	end)
end

local ALLY_SCAN_FOLDERS = { "PiggyNPC", "Outpost", "Forest", "Carnival", "City", "Mall", "Plant", "House", "LoadedMap" }

local function scanAllies()
	if not alliesNoDamageEnabled then
		return
	end
	for _, name in ipairs(ALLY_SCAN_FOLDERS) do
		local folder = workspace:FindFirstChild(name)
		if folder then
			if folder:IsA("Model") and isAlly(folder) then
				bindAlly(folder)
			end
			for _, obj in ipairs(folder:GetChildren()) do
				if obj:IsA("Model") and isAlly(obj) then
					bindAlly(obj)
				elseif obj:IsA("Folder") then
					for _, inner in ipairs(obj:GetChildren()) do
						if inner:IsA("Model") and isAlly(inner) then
							bindAlly(inner)
						end
					end
				end
			end
		end
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character and isAlly(plr.Character) then
			bindAlly(plr.Character)
		end
	end
end

