	return nil
end

local function updateRealPosition()
	local hrp = getLocalHRP()
	if not hrp then return end
	local currentCF = hrp.CFrame
	if not isNearSpoofSpot(currentCF) then
		realUserCFrame = currentCF
	end
end

local function rememberCollide(character)
	collideSnapshot = {}
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			collideSnapshot[part] = part.CanCollide
		end
	end
end

local function restoreCollide()
	if not collideSnapshot then
		return
	end
	for part, canCollide in pairs(collideSnapshot) do
		if part and part.Parent then
			part.CanCollide = canCollide
		end
	end
	collideSnapshot = nil
end

local function applyFullbright()
	if not savedLighting then
		savedLighting = {
