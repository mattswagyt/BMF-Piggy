local playerESPEnabled = false
local piggyESPEnabled = false
local enemyESPEnabled = false
local allyESPEnabled = false
local itemESPEnabled = false

local trackedEnemies = {}
local trackedItems = {}
local trackedPiggies = {}
local trackedAllies = {}
local originalItemNames = {}

local TARGET_MAP_NAMES = { "Forest", "Carnival", "City", "Mall", "Outpost", "Plant" }

local function detectEnemyInfo(model)
	if not model or not model:IsA("Model") then
		return nil
	end
	if Players:GetPlayerFromCharacter(model) then
		return nil
	end
	local piggyFolder = workspace:FindFirstChild("PiggyNPC")
	if piggyFolder and model:IsDescendantOf(piggyFolder) then
		return nil
	end

	-- Ignore Allies explicitly from Enemy ESP
	if model:FindFirstChild("GeorgieHead", true) 
		or model:FindFirstChild("BunnyHead", true) 
		or model:FindFirstChild("ZizzyHead", true) 
		or model:FindFirstChild("PonyHead", true) then
		return nil
	end

	-- 1. Foxy
	if model:FindFirstChild("FoxyHead", true) then
		return "Foxy", ORANGE
	end

	-- 2. Doggy (Enemy)
	if model:FindFirstChild("DogHead", true) then
		return "Doggy", BROWN
	end

	-- 3. Grandmother (PiggyHead ONLY if workspace.City exists)
	if workspace:FindFirstChild("City") and model:FindFirstChild("PiggyHead", true) then
		return "Grandmother", DARK_BLUE
	end

	-- 4. Mousy
	if model:FindFirstChild("MousyHead", true) and model:FindFirstChild("MousyPoints", true) then
		return "Mousy", BANANA
	end

	-- 5. Soldier (SoldierHelmet part & SoldierNPC BoolValue == true)
	local helmet = model:FindFirstChild("SoldierHelmet", true)
	local soldierNPC = model:FindFirstChild("SoldierNPC", true)
	if helmet and helmet:IsA("BasePart") and soldierNPC and soldierNPC:IsA("BoolValue") and soldierNPC.Value == true then
		return "Soldier", DARK_GREEN
	end

	-- 6. Mr. P (ONLY if workspace.Plant exists, has PhotoReady or named Mr. P, no GeorgieHead)
	local plantFolder = workspace:FindFirstChild("Plant")
	if plantFolder then
		local nameLower = string.lower(model.Name)
		local isMrPName = (nameLower == "mr. p" or nameLower == "mrp" or nameLower == "mr p")
		local photoReady = model:FindFirstChild("PhotoReady", true) or model:FindFirstChild("PhotoReady")
		
		if (isMrPName or photoReady) and not model:FindFirstChild("GeorgieHead", true) then
			return "Mr. P", PURPLE
		end
	end

	-- Fallback: STRICT ENEMY CHECK for generated/random bots
	-- Ensures it has a HumanoidRootPart to completely prevent highlighting doors/safes.
	local enemyVal = model:FindFirstChild("Enemy")
	if enemyVal and enemyVal:IsA("BoolValue") and enemyVal.Value == true then
		if model:FindFirstChild("HumanoidRootPart") then
			return cleanBotName(model.Name), RED
		end
	end

	return nil
end

local function detectAllyInfo(model)
	if not model or not model:IsA("Model") then
		return nil
	end
	if Players:GetPlayerFromCharacter(model) then
		return nil
	end

	if model:FindFirstChild("GeorgieHead", true) then
		return "Georgie", HOT_PINK
	end
	if model:FindFirstChild("ZizzyHead", true) then
		return "Zizzy", LIGHT_PURPLE
	end
	if model:FindFirstChild("PonyHead", true) then
		return "Pony", ORANGE
	end
	if model:FindFirstChild("BunnyHead", true) then
		return "Bunny", BANANA
	end

	-- Doggy Ally (when NOT designated as an Enemy)
	if model:FindFirstChild("DogHead", true) then
		local enemyVal = model:FindFirstChild("Enemy")
		if not (enemyVal and enemyVal:IsA("BoolValue") and enemyVal.Value == true) then
			return "Doggy", DARK_BROWN
		end
	end

	return nil
end

local function isPickupItem(obj)
	if not obj or not obj:IsA("BasePart") then
		return false
	end
	if obj:FindFirstChild("ItemPickupScript") then
		return true
	end
	local parent = obj.Parent
	if parent and (parent.Name == "ItemFolder" or string.lower(parent.Name):find("item")) then
		return true
	end
	local hasClick = obj:FindFirstChildWhichIsA("ClickDetector") ~= nil
	local hasMesh = obj:FindFirstChild("Mesh") ~= nil or obj:FindFirstChildWhichIsA("DataModelMesh") ~= nil
	local hasParticle = obj:FindFirstChildWhichIsA("ParticleEmitter") ~= nil
	if hasClick and (hasMesh or hasParticle) then
		return true
	end
	return false
end

local function isGeneratedItemName(name)
	if type(name) ~= "string" or name == "" or name == "Item" then
		return true
	end
	if name:match("^%-?%d+$") then
		return true
	end
	return false
end

local function itemDisplayName(item)
	local cached = originalItemNames[item]
	if type(cached) == "string" and not isGeneratedItemName(cached) then
		return cached
	end
	local n = item.Name
	if n and not isGeneratedItemName(n) then
		originalItemNames[item] = n
		return n
	end
	if type(cached) == "string" and cached ~= "" then
		return cached
	end
	return n or "Item"
end

local function itemColor(item)
	if item:IsA("BasePart") then
		return item.Color
	end
	return WHITE
end

local function cacheItemName(item)
	if not item then
		return
	end
	local locked = originalItemNames[item]
	if type(locked) == "string" and not isGeneratedItemName(locked) then
		return
	end
	local n = item.Name
	if not isGeneratedItemName(n) then
		originalItemNames[item] = n
	end
end

local function considerItem(obj)
	if not isPickupItem(obj) then
		return
	end
	cacheItemName(obj)
	trackedItems[obj] = {
		name = itemDisplayName(obj),
		color = itemColor(obj),
	}
end

local function scanItems()
	if not itemESPEnabled or not isInGameRound() then
		return
	end

	local itemFolder = workspace:FindFirstChild("ItemFolder")
	if itemFolder then
		for _, child in ipairs(itemFolder:GetChildren()) do
			considerItem(child)
		end
	end

	for _, child in ipairs(workspace:GetChildren()) do
		if child == itemFolder then
		elseif child:IsA("Folder") or child:IsA("Model") then
			local kids = child:GetChildren()
			local hits = 0
			local sample = math.min(#kids, 6)
			for i = 1, sample do
				if isPickupItem(kids[i]) then
					hits = hits + 1
				end
			end
			if hits > 0 then
				for _, k in ipairs(kids) do
					considerItem(k)
				end
			end
		elseif isPickupItem(child) then
			considerItem(child)
		end
	end
end

local function scanPiggies()
	if not piggyESPEnabled or not isInGameRound() then
		return
	end
	local folder = workspace:FindFirstChild("PiggyNPC")
	if not folder then
		return
	end
	for _, piggy in ipairs(folder:GetChildren()) do
		if piggy:IsA("Model") then
			trackedPiggies[piggy] = {
				name = cleanBotName(piggy.Name),
				color = RED
			}
		end
	end
end

local function scanEnemies()
	if not enemyESPEnabled or not isInGameRound() then
		return
	end

	for _, mapName in ipairs(TARGET_MAP_NAMES) do
		local mapFolder = workspace:FindFirstChild(mapName)
		if mapFolder then
			for _, desc in ipairs(mapFolder:GetDescendants()) do
				if desc:IsA("Model") then
					local name, color = detectEnemyInfo(desc)
					if name then
						trackedEnemies[desc] = { name = name, color = color }
					end
				end
			end
		end
	end

	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA("Model") and child.Name ~= "PiggyNPC" then
			local name, color = detectEnemyInfo(child)
			if name then
				trackedEnemies[child] = { name = name, color = color }
			end
		end
	end
end

local function scanAlliesESP()
	if not allyESPEnabled or not isInGameRound() then
		return
	end

	for _, mapName in ipairs(TARGET_MAP_NAMES) do
		local mapFolder = workspace:FindFirstChild(mapName)
		if mapFolder then
			for _, desc in ipairs(mapFolder:GetDescendants()) do
				if desc:IsA("Model") then
					local name, color = detectAllyInfo(desc)
					if name then
