local function runRemote(url, label)
	local ok, err = pcall(function()
		loadstring(game:HttpGet(url))()
	end)
	if not ok then
		logError((label or "Script") .. " failed: " .. tostring(err))
	end
end

createButton(ScriptsScroll, "Infinite Yield", function()
	runRemote("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source", "Infinite Yield")
end)

