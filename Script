task.spawn(function()
	while true do
		if godModeEnabled then
			pcall(scanGodMode)
			-- light refresh of already-tracked models (Enemy flag only, not full tree every time)
			local n = 0
			for model in pairs(godTracked) do
				if model and model.Parent then
					local enemy = model:FindFirstChild("Enemy")
					if enemy and enemy:IsA("BoolValue") and enemy.Value == true then
						enemy.Value = false
					end
				else
					godTracked[model] = nil
				end
				n += 1
				if n % 8 == 0 then
					task.wait()
				end
			end
		end
		if alliesNoDamageEnabled then
			pcall(scanAllies)
			local n = 0
			for model in pairs(alliesTracked) do
				if not (model and model.Parent) then
					alliesTracked[model] = nil
				else
					local enemy = model:FindFirstChild("Enemy")
					if enemy and enemy:IsA("BoolValue") and enemy.Value == true then
						enemy.Value = false
					end
				end
				n += 1
				if n % 8 == 0 then
					task.wait()
				end
			end
		end
		task.wait(0.6)
	end
end)

workspace.ChildAdded:Connect(function(child)
	if godModeEnabled then
		task.delay(0.25, function()
			pcall(scanGodMode)
		end)
	end
	if alliesNoDamageEnabled then
		task.delay(0.25, function()
			pcall(scanAllies)
		end)
	end
	if child.Name == "Plant" then
		child.DescendantAdded:Connect(function(obj)
			if godModeEnabled then
				handleMrP(obj)
			end
		end)
	end
	if child.Name == "Mall" then
		child.DescendantAdded:Connect(function(v)
			if godModeEnabled and v:IsA("Model") and v.Name == "Lasers" then
				v:Destroy()
			end
		end)
	end
end)

