				while clone.Parent do
					local target, dist = nil, math.huge
					for _, plr in ipairs(Players:GetPlayers()) do
						if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
							local d = (plr.Character.HumanoidRootPart.Position - botHrp.Position).Magnitude
							if d < dist then
								dist = d
								target = plr.Character.HumanoidRootPart
							end
						end
					end
					if target then botHum:MoveTo(target.Position) end
					task.wait(0.2)
				end
			end
		end)
		
		StarterGui:SetCore("SendNotification", { Title = "Spawned", Text = val .. " spawned successfully!", Duration = 3 })
	else
		logError("Bot model '" .. tostring(val) .. "' not found in ReplicatedStorage.")
	end
end)

RunService.Heartbeat:Connect(function()
	if mrPNoDamageEnabled then
		local plant = workspace:FindFirstChild("Plant")
		if not plant then
			mrPModel = nil
			mrPPlantRef = nil
		else
			if mrPPlantRef ~= plant then
				mrPPlantRef = plant
				mrPModel = nil
			end
			local now = os.clock()
			if (now - mrPLastScan) > 0.2 or not (mrPModel and mrPModel.Parent) then
				mrPLastScan = now
				local fresh = findMrPModel(plant)
				if fresh then
					mrPModel = fresh
				end
			end
			if mrPModel and mrPModel.Parent then
				neuterMrP(mrPModel)
			end
		end
	end

	-- Control Bot/Enemy Logic
	if controlledModel and controlledModel.Parent then
		local myChar = LocalPlayer.Character
		if myChar and myChar:FindFirstChild("HumanoidRootPart") then
			local myHRP = myChar.HumanoidRootPart
			local botHRP = controlledModel:FindFirstChild("HumanoidRootPart")
			if botHRP then
				botHRP.CFrame = myHRP.CFrame
				botHRP.Velocity = myHRP.AssemblyLinearVelocity
				
				for _, part in ipairs(myChar:GetDescendants()) do
					if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
						part.LocalTransparencyModifier = 1
					end
				end
			end
		end
	else
		local myChar = LocalPlayer.Character
		if myChar then
			for _, part in ipairs(myChar:GetDescendants()) do
				if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.LocalTransparencyModifier == 1 then
					part.LocalTransparencyModifier = 0
				end
			end
		end
	end

	-- CFrame Spoofing Loop
	local myHRP = getLocalHRP()
	if myHRP and not flying then
		local spoofTarget = getSpoofTarget()
		if spoofTarget then
			realUserCFrame = myHRP.CFrame
			myHRP.CFrame = spoofTarget
			cframeSpoofPending = true
		else
			if cframeSpoofPending then
				cframeSpoofPending = false
			end
		end
	end
end)

local function restoreRealCFrame()
	-- Restores real position instantly for local physics and camera before they process
	if cframeSpoofPending and realUserCFrame and not flying then
		local hrp = getLocalHRP()
		if hrp then
			hrp.CFrame = realUserCFrame
		end
	end
end

