local function isTraitorPlayer(player, character)
	local char = character or (player and player.Character)
	if char then
		local t1 = char:FindFirstChild("Traitor")
		if t1 and t1:IsA("BoolValue") and t1.Value == true then
			return true
		end
	end
	if player then
		local t2 = player:FindFirstChild("Traitor")
		if t2 and t2:IsA("BoolValue") and t2.Value == true then
			return true
		end
	end
	return false
end

local function isEnemyCharacter(character)
	if not character then
		return false
	end
	local enemy = character:FindFirstChild("Enemy")
	if enemy and enemy:IsA("BoolValue") and enemy.Value == true then
		return true
	end
	return false
end

local function getPiggyPlayerName()
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		if char and isEnemyCharacter(char) then
			return player.Name
		end
	end
	return nil
end

local function cleanBotName(rawName)
	if type(rawName) ~= "string" or rawName == "" then
		return "Piggy"
	end
	local clean = rawName:gsub("Bot", ""):gsub("NPC", ""):gsub("bot", ""):gsub("npc", "")
	clean = clean:match("^%s*(.-)%s*$")
	if clean == "" then
		return "Piggy"
	end
	return clean
end

