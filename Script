local alliesBtn = createButton(ExploitsScroll, "Allies Don't Deal Damage: OFF", function(button)
	alliesNoDamageEnabled = not alliesNoDamageEnabled
	setToggleVisual(button, alliesNoDamageEnabled, "Allies Don't Deal Damage: ON", "Allies Don't Deal Damage: OFF")
	if alliesNoDamageEnabled then
		scanAllies()
	end
end)
