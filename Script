	end
	local char = LocalPlayer.Character
	if not char then
		return
	end

	local healthScript = char:FindFirstChild("Health")
	if healthScript then
		pcall(function()
			healthScript:Destroy()
		end)
	end

	local hrp = char:FindFirstChild("HumanoidRootPart")
