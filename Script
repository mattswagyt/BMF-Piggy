local trackedItems = {} -- [instance] = {name=, color=}
local trackedPiggies = {} -- [model] = true
local originalItemNames = {}

local ENEMY_MAPS = { "Forest", "Carnival", "City", "Mall", "Plant" }

local function detectEnemyInfo(model)
	if not model or not model:IsA("Model") then
		return nil
	end
	if model:FindFirstChild("DogHead", true) then
		return "Doggy", Color3.fromRGB(139, 69, 19)
	end
	if model:FindFirstChild("FoxyHead", true) then
		return "Foxy", Color3.fromRGB(255, 140, 0)
	end
	if model:FindFirstChild("PiggyHead", true) then
		return "Grandmother", Color3.fromRGB(0, 0, 139)
	end
	if model:FindFirstChild("MousyHead", true) and model:FindFirstChild("MousyPoints", true) then
		return "Mousy", Color3.fromRGB(255, 255, 102)
	end
	if model:FindFirstChild("Projectiles") then
		return "Mr. P", Color3.fromRGB(128, 0, 128)
	end
	return nil
end

local function isPickupItem(obj)
	if not obj or not obj:IsA("BasePart") then
		return false
	end
	if obj:FindFirstChild("ItemPickupScript") then
		return true
	end
	local parent = obj.Parent
	if parent and (parent.Name == "ItemFolder" or string.lower(parent.Name):find("item")) then
		return true
	end
	local hasClick = obj:FindFirstChildWhichIsA("ClickDetector") ~= nil
	local hasMesh = obj:FindFirstChild("Mesh") ~= nil or obj:FindFirstChildWhichIsA("DataModelMesh") ~= nil
	local hasParticle = obj:FindFirstChildWhichIsA("ParticleEmitter") ~= nil
	if hasClick and (hasMesh or hasParticle) then
		return true
	end
	return false
end

local function itemDisplayName(item)
	local cached = originalItemNames[item]
	if cached and not tostring(cached):match("^%-?%d+$") then
		return cached
	end
	local n = item.Name
	if n and not n:match("^%-?%d+$") then
		return n
	end
	local sv = item:FindFirstChildWhichIsA("StringValue")
	if sv and sv.Value ~= "" and not tostring(sv.Value):match("^%-?%d+$") then
		return sv.Value
	end
	return "Item"
end

local function itemColor(item)
	if item:IsA("BasePart") then
		return item.Color
	end
	return WHITE
end

local function cacheItemName(item)
	if originalItemNames[item] then
		return
	end
	originalItemNames[item] = item.Name
end

local function considerItem(obj)
	if not isPickupItem(obj) then
		return
	end
	cacheItemName(obj)
	trackedItems[obj] = {
		name = itemDisplayName(obj),
		color = itemColor(obj),
	}
end

local function scanItems()
	if not itemESPEnabled then
		return
	end

	local itemFolder = workspace:FindFirstChild("ItemFolder")
	if itemFolder then
		for _, child in ipairs(itemFolder:GetChildren()) do
			considerItem(child)
		end
	end

	for _, child in ipairs(workspace:GetChildren()) do
		if child == itemFolder then
			-- already handled
		elseif child:IsA("Folder") or child:IsA("Model") then
			local kids = child:GetChildren()
			local hits = 0
			local sample = math.min(#kids, 6)
			for i = 1, sample do
				if isPickupItem(kids[i]) then
					hits += 1
				end
			end
			if hits > 0 then
				for _, k in ipairs(kids) do
					considerItem(k)
				end
			end
		elseif isPickupItem(child) then
			considerItem(child)
		end
	end
end

local function scanPiggies()
	if not piggyESPEnabled then
		return
	end
	local folder = workspace:FindFirstChild("PiggyNPC")
	if not folder then
		return
	end
	for _, piggy in ipairs(folder:GetChildren()) do
		if piggy:IsA("Model") then
			trackedPiggies[piggy] = true
		end
	end
end

local function scanEnemies()
	if not enemyESPEnabled then
		return
	end
	for _, mapName in ipairs(ENEMY_MAPS) do
		local map = workspace:FindFirstChild(mapName)
		if map then
			for _, obj in ipairs(map:GetDescendants()) do
				if obj:IsA("Model") then
					local name, color = detectEnemyInfo(obj)
					if name then
						trackedEnemies[obj] = { name = name, color = color }
					end
				end
			end
		end
	end
end

