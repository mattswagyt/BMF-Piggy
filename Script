local function httpGet(url)
	local ok, result = pcall(function()
		if game.HttpGet then
			return game:HttpGet(url)
		end
		if game.HttpGetAsync then
			return game:HttpGetAsync(url)
		end
		return nil
	end)
	if ok and type(result) == "string" and #result > 50 then
		return result
	end
	return nil
end

local function runRemote(url, label)
	local body = httpGet(url)
	if not body then
		logError((label or "Script") .. " download failed (HttpGet returned nil)")
		return
	end
	if not loadstring then
		logError((label or "Script") .. " failed: loadstring is not available")
		return
	end
	local fn, compileErr = loadstring(body)
	if not fn then
		logError((label or "Script") .. " compile failed: " .. tostring(compileErr))
		return
	end
	local ok, err = pcall(fn)
	if not ok then
		logError((label or "Script") .. " failed: " .. tostring(err))
	end
end

