local function destroyTouch(obj)
	if not obj then
		return
	end
	local className = ""
	pcall(function()
		className = obj.ClassName
	end)
	if obj.Name == "TouchInterest" or obj.Name == "TouchTransmitter" or className == "TouchTransmitter" then
		pcall(function()
			obj:Destroy()
		end)
	end
end

local function purgeHeadAndRootTouches(model)
	if not model then
		return
	end
	local enemy = model:FindFirstChild("Enemy")
	if enemy and enemy:IsA("BoolValue") then
		enemy.Value = false
	end
	local function purgePart(part)
		if not part or not part:IsA("BasePart") then
			return
		end
		for _, v in ipairs(part:GetChildren()) do
			destroyTouch(v)
		end
		for _, v in ipairs(part:GetDescendants()) do
			destroyTouch(v)
		end
	end
	purgePart(model:FindFirstChild("Head"))
	purgePart(model:FindFirstChild("HumanoidRootPart"))
end

local function neuterModel(model)
	if not model then
		return
	end
	local enemy = model:FindFirstChild("Enemy")
	if enemy and enemy:IsA("BoolValue") then
		enemy.Value = false
	end
	for _, v in ipairs(model:GetDescendants()) do
		destroyTouch(v)
	end
end

local function bindNeuter(model)
	if not model or godTracked[model] then
		return
	end
	godTracked[model] = true
	neuterModel(model)

	model.DescendantAdded:Connect(function(obj)
		if godModeEnabled then
			destroyTouch(obj)
		end
	end)
	model.ChildAdded:Connect(function(child)
		if godModeEnabled and child.Name == "Enemy" and child:IsA("BoolValue") then
			child.Value = false
		end
	end)
end

