--------------------------------------------------
-- LAG-FREE ESP CORE (single render loop, reused drawings)
--------------------------------------------------

local DrawingAvailable = (type(Drawing) == "table" and type(Drawing.new) == "function")
local ESP_Tracers = {}

local function getWorldPosition(target)
	if not target then
		return nil
	end
	if target:IsA("BasePart") then
		return target.Position
	end
	if target:IsA("Model") then
		local hrp = target:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			return hrp.Position
		end
		local ok, cf = pcall(function()
			return target:GetPivot()
		end)
		if ok and cf then
			return cf.Position
		end
		local part = target:FindFirstChildWhichIsA("BasePart")
		if part then
			return part.Position
		end
	end
	return nil
end

local function highlightTarget(target, color, customName)
	if not target then
		return
	end
	local hlName = customName or "BMF_Highlight"
	local highlight = target:FindFirstChild(hlName)
	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = hlName
		highlight.Adornee = target
		highlight.OutlineColor = WHITE
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = target
	end
	highlight.FillColor = color
	highlight.Enabled = true
end

local function removeHighlight(target, customName)
	if not target then
		return
	end
	local hlName = customName or "BMF_Highlight"
	local highlight = target:FindFirstChild(hlName)
	if highlight then
		highlight:Destroy()
	end
end

local function updateTracer(target, color, tagKey)
	if not DrawingAvailable then
		return
	end
	if not ESP_Tracers[tagKey] then
		local ok, line = pcall(function()
			return Drawing.new("Line")
		end)
		if not ok or not line then
			return
		end
		line.Thickness = 2
		ESP_Tracers[tagKey] = line
	end

	local line = ESP_Tracers[tagKey]
	local camera = workspace.CurrentCamera
	local worldPos = getWorldPosition(target)

	if camera and worldPos then
		local pos, onScreen = camera:WorldToViewportPoint(worldPos)
		if onScreen and pos.Z > 0 then
			line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
			line.To = Vector2.new(pos.X, pos.Y)
			line.Color = color
			line.Visible = true
			return
		end
	end
	line.Visible = false
end

local function removeTracer(tagKey)
	local line = ESP_Tracers[tagKey]
	if line then
		pcall(function()
			line.Visible = false
			line:Remove()
		end)
		ESP_Tracers[tagKey] = nil
	end
end

local function updateNameTag(target, text, color)
	if not target then
		return
	end
	local billboard = target:FindFirstChild("BMF_NameTag")
	if not billboard then
		billboard = Instance.new("BillboardGui")
		billboard.Name = "BMF_NameTag"
		billboard.Size = UDim2.new(0, 200, 0, 50)
		billboard.StudsOffset = Vector3.new(0, 3, 0)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = 5000
		billboard.Parent = target

		local label = Instance.new("TextLabel")
		label.Name = "TagLabel"
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.TextStrokeTransparency = 0
		label.TextScaled = true
		label.Font = UI_FONT
		label.Parent = billboard
	end

	local label = billboard:FindFirstChild("TagLabel")
	if label then
		label.Text = text
		label.TextColor3 = color
	end
end

local function removeNameTag(target)
	if not target then
		return
	end
	local billboard = target:FindFirstChild("BMF_NameTag")
	if billboard then
		billboard:Destroy()
	end
end

local function clearESPOn(target, hlName, tagKey)
	removeHighlight(target, hlName)
	removeNameTag(target)
	if tagKey then
		removeTracer(tagKey)
	end
end

