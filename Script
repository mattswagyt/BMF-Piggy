			else
				removeTracer("piggy_" .. tostring(piggy))
				trackedPiggies[piggy] = nil
			end
		end
	end

	if enemyESPEnabled then
		for model, info in pairs(trackedEnemies) do
			if model and model.Parent then
				highlightTarget(model, info.color, "BMF_Enemy_Highlight")
				updateTracer(model, info.color, "enemy_" .. tostring(model))
				updateNameTag(model, info.name, info.color)
			else
				removeTracer("enemy_" .. tostring(model))
				trackedEnemies[model] = nil
			end
		end
	end

	if itemESPEnabled then
		for item, info in pairs(trackedItems) do
			if item and item.Parent then
				local col = itemColor(item)
				local name = itemDisplayName(item)
				highlightTarget(item, col, "BMF_Item_Highlight")
				updateTracer(item, col, "item_" .. tostring(item))
				updateNameTag(item, name, col)
			else
				removeTracer("item_" .. tostring(item))
				trackedItems[item] = nil
				originalItemNames[item] = nil
			end
		end
	end
end)

--------------------------------------------------
-- EXPLOITS TAB  (event-driven God Mode / Allies — no per-frame GetDescendants)
--------------------------------------------------

local godModeEnabled = false
local alliesNoDamageEnabled = false
local godTracked = {} -- [model] = true
local alliesTracked = {} -- [model] = true

local ALLY_HEADS = {
	DogHead = true,
	BunnyHead = true,
	ZizzyHead = true,
	PonyHead = true,
	GeorgieHead = true,
}

local GOD_MAPS = {
	{ name = "City", head = "PiggyHead", grandmother = true },
	{ name = "Carnival", head = "FoxyHead", grandmother = false },
	{ name = "Forest", head = "DogHead", grandmother = false },
}

local function destroyTouch(obj)
	if not obj then
		return
	end
	if obj:IsA("TouchTransmitter") or obj.Name == "TouchInterest" then
		obj:Destroy()
	end
end

local function neuterModel(model)
	if not model then
		return
	end
	local enemy = model:FindFirstChild("Enemy")
	if enemy and enemy:IsA("BoolValue") then
		enemy.Value = false
	end
	for _, v in ipairs(model:GetDescendants()) do
		destroyTouch(v)
	end
end

local function bindNeuter(model)
	if not model or godTracked[model] then
		return
	end
	godTracked[model] = true
	neuterModel(model)

	model.DescendantAdded:Connect(function(obj)
		if godModeEnabled then
			destroyTouch(obj)
		end
	end)
	model.ChildAdded:Connect(function(child)
		if godModeEnabled and child.Name == "Enemy" and child:IsA("BoolValue") then
			child.Value = false
		end
	end)
end

local function handleMrP(obj)
	if obj.Name ~= "HomingProjectile" then
		return
	end
	for _, v in ipairs(obj:GetDescendants()) do
		destroyTouch(v)
	end
	obj.DescendantAdded:Connect(function(child)
		if godModeEnabled then
			destroyTouch(child)
		end
	end)
end

local function handleLasers(container)
	if not container then
		return
	end
	for _, v in ipairs(container:GetDescendants()) do
		if v:IsA("Model") and v.Name == "Lasers" then
			v:Destroy()
		end
	end
end

local function scanGodMode()
	if not godModeEnabled then
		return
	end

	for _, info in ipairs(GOD_MAPS) do
		local map = workspace:FindFirstChild(info.name)
		if map then
			for _, obj in ipairs(map:GetDescendants()) do
				if obj:IsA("Model") and (obj:FindFirstChild("Enemy") or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild(info.head, true)) then
					bindNeuter(obj)
				end
			end
		end
	end

	local mall = workspace:FindFirstChild("Mall")
	if mall then
		for _, obj in ipairs(mall:GetDescendants()) do
			if obj:IsA("Model") then
				local hasHead = obj:FindFirstChild("MousyHead", true)
				local hasPoints = obj:FindFirstChild("MousyPoints", true)
				if hasHead and hasPoints then
					bindNeuter(obj)
				end
			end
		end
		local loaded = workspace:FindFirstChild("LoadedMap")
		if loaded and loaded:FindFirstChild("Part1") then
			local jail = loaded.Part1:FindFirstChild("JailbreakEvent")
			if jail then
				handleLasers(jail)
			end
		end
	end

	local plant = workspace:FindFirstChild("Plant")
	if plant then
		for _, obj in ipairs(plant:GetDescendants()) do
			handleMrP(obj)
		end
	end

	local piggyFolder = workspace:FindFirstChild("PiggyNPC")
	if piggyFolder then
		for _, bot in ipairs(piggyFolder:GetChildren()) do
			if bot:IsA("Model") then
				bindNeuter(bot)
			end
		end
	end

	local outpost = workspace:FindFirstChild("Outpost")
	if outpost then
		for _, folder in ipairs(outpost:GetChildren()) do
			if folder:IsA("Folder") or folder:IsA("Model") then
				for _, model in ipairs(folder:GetChildren()) do
					if model:IsA("Model") then
						bindNeuter(model)
					end
				end
			elseif folder:IsA("Model") then
				bindNeuter(folder)
			end
		end
	end
end

local function isAlly(model)
	if not model or not model:IsA("Model") then
		return false
	end
	for headName in pairs(ALLY_HEADS) do
		if model:FindFirstChild(headName, true) then
			return true
		end
	end
	return false
end

local function bindAlly(model)
	if not model or alliesTracked[model] then
		return
	end
	alliesTracked[model] = true
	neuterModel(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Attacking, false)
		end)
	end
	model.DescendantAdded:Connect(function(obj)
		if alliesNoDamageEnabled then
			destroyTouch(obj)
		end
	end)
end

local ALLY_SCAN_FOLDERS = { "PiggyNPC", "Outpost", "Forest", "Carnival", "City", "Mall", "Plant", "House", "LoadedMap" }

local function scanAllies()
	if not alliesNoDamageEnabled then
		return
	end
	for _, name in ipairs(ALLY_SCAN_FOLDERS) do
		local folder = workspace:FindFirstChild(name)
		if folder then
			if folder:IsA("Model") and isAlly(folder) then
				bindAlly(folder)
			end
			for _, obj in ipairs(folder:GetChildren()) do
				if obj:IsA("Model") and isAlly(obj) then
					bindAlly(obj)
				elseif obj:IsA("Folder") then
					for _, inner in ipairs(obj:GetChildren()) do
						if inner:IsA("Model") and isAlly(inner) then
							bindAlly(inner)
						end
					end
				end
			end
		end
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character and isAlly(plr.Character) then
			bindAlly(plr.Character)
		end
	end
end

local godBtn = createButton(ExploitsScroll, "God Mode: OFF", function(button)
	godModeEnabled = not godModeEnabled
	setToggleVisual(button, godModeEnabled, "God Mode: ON", "God Mode: OFF")
	if godModeEnabled then
		scanGodMode()
	end
end)
