local function createDropdown(parent, name, getOptionsCallback, onSelectCallback)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, -10, 0, 30)
	container.BackgroundTransparency = 1
	container.Parent = parent

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, 0, 0, 30)
	button.BackgroundColor3 = PINK_BTN
	button.TextColor3 = WHITE
	button.Font = BODY_FONT
	button.TextSize = 16
	button.BorderSizePixel = 0
	button.AutoButtonColor = true
	button.Text = name .. " ▼"
	button.Parent = container

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 4)
	c.Parent = button

	local dropFrame = Instance.new("ScrollingFrame")
	dropFrame.Size = UDim2.new(1, 0, 0, 0)
	dropFrame.Position = UDim2.new(0, 0, 0, 35)
	dropFrame.BackgroundColor3 = PINK_DARK
	dropFrame.BorderSizePixel = 0
	dropFrame.ScrollBarThickness = 4
	dropFrame.Visible = false
	dropFrame.Parent = container
	dropFrame.ZIndex = 5

	local dc = Instance.new("UICorner")
	dc.CornerRadius = UDim.new(0, 4)
	dc.Parent = dropFrame

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 2)
	layout.Parent = dropFrame

	local open = false
	button.MouseButton1Click:Connect(function()
		open = not open
		button.Text = name .. (open and " ▲" or " ▼")
		if open then
			local options = getOptionsCallback()
			for _, child in ipairs(dropFrame:GetChildren()) do
				if child:IsA("TextButton") then child:Destroy() end
			end
			local h = 0
			for _, opt in ipairs(options) do
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, -8, 0, 25)
				btn.BackgroundColor3 = PINK_MID
				btn.TextColor3 = WHITE
				btn.Text = opt.name
				btn.Font = BODY_FONT
				btn.TextSize = 14
				btn.BorderSizePixel = 0
				btn.Parent = dropFrame
				btn.ZIndex = 6
				
				local btnC = Instance.new("UICorner")
				btnC.CornerRadius = UDim.new(0, 4)
				btnC.Parent = btn
				
				btn.MouseButton1Click:Connect(function()
					pcall(function() onSelectCallback(opt.value) end)
					open = false
					button.Text = name .. " ▼"
					container.Size = UDim2.new(1, -10, 0, 30)
					dropFrame.Visible = false
				end)
				h = h + 27
			end
			local totalH = math.min(h, 150)
			dropFrame.Size = UDim2.new(1, 0, 0, totalH)
			dropFrame.CanvasSize = UDim2.new(0, 0, 0, h)
			dropFrame.Visible = true
			container.Size = UDim2.new(1, -10, 0, 35 + totalH)
		else
			dropFrame.Visible = false
			container.Size = UDim2.new(1, -10, 0, 30)
		end
	end)
	return container
end

