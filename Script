--------------------------------------------------
-- LAG-FREE ESP CORE (single render loop, reused drawings)
--------------------------------------------------

local DrawingAvailable = (type(Drawing) == "table" and type(Drawing.new) == "function")
local ESP_Tracers = {}

local function getWorldPosition(target)
	if not target then
		return nil
	end
	if target:IsA("BasePart") then
		return target.Position
	end
	if target:IsA("Model") then
		local hrp = target:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			return hrp.Position
		end
		local ok, cf = pcall(function()
			return target:GetPivot()
		end)
		if ok and cf then
			return cf.Position
		end
		local part = target:FindFirstChildWhichIsA("BasePart")
		if part then
			return part.Position
		end
	end
	return nil
end

local function highlightTarget(target, color, customName)
	if not target then
		return
	end
	local hlName = customName or "BMF_Highlight"
	local highlight = target:FindFirstChild(hlName)
	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = hlName
		highlight.Adornee = target
		highlight.OutlineColor = WHITE
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = target
	end
	highlight.FillColor = color
	highlight.Enabled = true
end

local function removeHighlight(target, customName)
	if not target then
		return
	end
	local hlName = customName or "BMF_Highlight"
	local highlight = target:FindFirstChild(hlName)
	if highlight then
		highlight:Destroy()
	end
end

local function updateTracer(target, color, tagKey)
	if not DrawingAvailable then
		return
	end
	local line = ESP_Tracers[tagKey]

	if not isInGameRound() then
		if line then
			line.Visible = false
		end
		return
	end

	if not line then
		local ok, newLine = pcall(function()
			return Drawing.new("Line")
		end)
		if not ok or not newLine then
			return
		end
		newLine.Thickness = 2
		ESP_Tracers[tagKey] = newLine
		line = newLine
	end

	local camera = workspace.CurrentCamera
	local worldPos = getWorldPosition(target)

	if camera and worldPos then
		local pos, onScreen = camera:WorldToViewportPoint(worldPos)
		if onScreen and pos.Z > 0 then
			line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
			line.To = Vector2.new(pos.X, pos.Y)
			line.Color = color
			line.Visible = true
			return
		end
	end
	line.Visible = false
end

local function removeTracer(tagKey)
	local line = ESP_Tracers[tagKey]
	if line then
		pcall(function()
			line.Visible = false
			line:Remove()
		end)
		ESP_Tracers[tagKey] = nil
	end
end

local function hideAllTracers()
	for _, line in pairs(ESP_Tracers) do
		if line then
			line.Visible = false
		end
	end
end

local function updateNameTag(target, text, color)
	if not target then
		return
	end
	local billboard = target:FindFirstChild("BMF_NameTag")
	if not billboard then
		billboard = Instance.new("BillboardGui")
